# Optional Anthropic API-billing alternative. Prefer Claude account login in the web app
# for browser automation. Discovery, tracking, and heuristic preparation need neither.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=
# LLM_MODEL=

# Optional: raises GitHub API/raw-file limits for frequent polling.
# GITHUB_TOKEN=

# Optional runtime overrides.
# TIAAA_HOME=/absolute/path/to/tiaaa-data
# CHROME_PATH=/absolute/path/to/chrome
# Comma-separated hostnames accepted by the dashboard when it is reverse-proxied.
# TIAAA_TRUSTED_HOSTS=applications.example.edu
# Override only after reviewing a compatible release. TI-AAA pins 0.0.79 by default.
# TIAAA_PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@0.0.79
# TIAAA_DEBUG_AGENT_OUTPUT=0
