# Optional AI preparation provider. The discovery and tracker work without an LLM.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=
# LLM_MODEL=

# Optional: raises GitHub API/raw-file limits for frequent polling.
GITHUB_TOKEN=

# Optional password for ordinary employer-owned ATS account creation.
TIAAA_APPLICATION_PASSWORD=

# Optional runtime overrides.
# TIAAA_HOME=/absolute/path/to/tiaaa-data
# CHROME_PATH=/absolute/path/to/chrome
# Override only after reviewing a compatible release. TI-AAA pins 0.0.78 by default.
# TIAAA_PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@0.0.78
# TIAAA_DEBUG_AGENT_OUTPUT=0
